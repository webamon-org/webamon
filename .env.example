# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit it.

# --- OpenSearch admin password (REQUIRED) ---
# OpenSearch refuses weak passwords: use at least 8 characters with upper and
# lower case letters, a digit and a special character.
OPENSEARCH_ADMIN_PASSWORD=

# --- MaxMind GeoLite2 (optional) ---
# Free account: https://www.maxmind.com/en/geolite2/signup
# Without these, scans still run but carry no country/ASN data.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Scanner API key (optional) ---
# When set, POST /scan requires the header  x-api-key: <value>
SANDBOX_API_KEY=

# --- Host ports (optional; change them if something else already uses them) ---
SANDBOX_PORT=5000
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601

# --- Scanner tuning (optional) ---
THREADS=4
BROWSER_POOL_SIZE=2
SCAN_TIMEOUT=30
# Milliseconds to keep capturing after page load (catches lazily loaded requests).
POST_LOAD_DWELL_MS=0
# ALL = resolve every domain on the page, MAIN = only the page's own domain, NONE = skip DNS
DNS=ALL
SAVE_DOM=True
SAVE_RESOURCES=True
SAVE_SCREENSHOT=False
FAVICON_HASHING=True
LOG_LEVEL=INFO
SANDBOX_MEM_LIMIT=3g
